.webiIframeV2Layout.playerVisible:not(.fullScreen) { height: calc(100% - va=
r(--play-controls-height)); }

body:has(> .webiIframeV2Layout:not(.fullScreen):not(.sc-hidden)) { display:=
 grid; grid-template-rows: minmax(var(--header-height),auto) minmax(0,1fr);=
 grid-auto-rows: 0px; height: 100vh; padding: 0px; overflow-y: hidden; }

body.m-hideHeader:has(> .webiIframeV2Layout:not(.fullScreen):not(.sc-hidden=
)) { grid-template-rows: minmax(0px, auto) minmax(0px, 1fr); }

body:has(> .webiIframeV2Layout:not(.fullScreen):not(.sc-hidden)) > #app { g=
rid-row: 1; }

body:has(> .webiIframeV2Layout:not(.fullScreen):not(.sc-hidden)) > .webiIfr=
ameV2Layout { grid-row: 2; }

.webiEmbeddedModuleIframe { background: none; border: 0px; width: 100%; ove=
rflow: hidden; z-index: 3; }

body.crossfade-iframe-active { overflow-y: hidden; }

body.file-drag-active .webiIframe { pointer-events: none; }

.skipToContent { display: none; }

body:has(> .webiIframeV2Layout:not(.fullScreen):not(.sc-hidden)) .skipToCon=
tent { display: block; position: fixed; top: -100px; left: 8px; z-index: 20=
01; padding: 8px 16px; border-radius: 4px; background: var(--background-sur=
face-color); color: var(--font-primary-color); text-decoration: none; trans=
ition: top 0.15s ease-in-out; }

body:has(> .webiIframeV2Layout:not(.fullScreen):not(.sc-hidden)) .skipToCon=
tent:focus { top: 8px; }

:root { --mui-error-dark-color: #b40030; }

.mui-btn, .mui-btn:visited { display: inline-block; padding: 8px 24px; bord=
er-radius: 1000px; border: 1.5px solid transparent; text-align: center; cur=
sor: pointer; background-color: rgb(18, 18, 18); color: rgb(255, 255, 255);=
 font-size: 14px; font-family: var(--font-sans-serif-family); line-height: =
20px; overflow-wrap: break-word; }

.mui-btn.mui-btn-secondary { background-color: rgb(245, 245, 245); color: r=
gb(18, 18, 18); }

