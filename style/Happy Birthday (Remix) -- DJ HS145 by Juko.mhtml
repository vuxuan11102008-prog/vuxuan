8, 18, 18, 0.08); }

.mui-btn-outline { background-color: initial; color: rgb(18, 18, 18); borde=
r: 1.5px solid rgba(102, 102, 102, 0.15); }

.mui-btn-outline:hover { outline-color: rgba(18, 18, 18, 0.16); background-=
color: rgb(245, 245, 245); }

.l-container { width: 1240px; margin: 0px auto; }

